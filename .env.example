# ==========================================
# 1. 基础系统与网络配置
# ==========================================
PROJECT_NAME="PolyMatrix Engine"
DEBUG=True

# Polymarket 网络设置 (默认: Polygon Mainnet)
PM_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PM_API_URL=https://clob.polymarket.com
PM_CHAIN_ID=137
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# ==========================================
# 2. 账号与权限凭证 (注意保密)
# ==========================================
PK=your_private_key_here
FUNDER_ADDRESS=your_wallet_address_here

# ==========================================
# 3. 数据库与 Redis 持久化
# ==========================================
# DB_PORT: Docker 映射外部端口(默认 5433，以防和本地 5432 冲突)
DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5433/polymatrix
# REDIS_PORT: Docker 映射外部端口(默认 6380，以防和本地 6379 冲突)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ==========================================
# 4. 交易总控与风险管理
# ==========================================
# 交易模式：disabled=完全禁止启动引擎；paper=本地模拟；live=申请真实执行。
# 安全默认值必须保持 disabled。旧 LIVE_TRADING_ENABLED=True 单独不再具备解锁能力。
TRADING_MODE=disabled
LIVE_TRADING_ENABLED=False
# live 需要同时满足以下全部条件，且授权有效期不得超过未来 24 小时：
# 1) FUNDER_ADDRESS 位于逗号分隔的白名单；2) GLOBAL_MAX_BUDGET 不超过显式 live ceiling；
# 3) LIVE_ARM_TOKEN 与 wallet + expiry + budget 匹配；4) 运行时全部 readiness 通过。
LIVE_ALLOWED_FUNDER_ADDRESSES=
LIVE_ARM_EXPIRES_AT=
LIVE_ARM_TOKEN=
LIVE_BUDGET_CAP_USD=100.0
# 奖励排名 Auto-Router 永久限制为 paper-only，live 不存在解锁开关。
# 仅在交易所成交 payload 的绝对手续费字段完成契约测试后才能设为 True。
# 缺失手续费绝不按 0 处理；未验证时 live 静态授权直接失败。
LIVE_FEE_ACCOUNTING_VALIDATED=False
APP_CODE_COMMIT=

# 所有 start/stop/halt/wipe 写接口使用 Bearer Token；至少 32 字符。
# 留空时写接口整体关闭。
ADMIN_API_TOKEN=
# wipe 默认永久关闭；临时开启仍要求 disabled 模式、无活动引擎和确认请求头。
ENABLE_ADMIN_WIPE=False
# 旧 0.01 全量强平与 wallet-wide Periodic Hard Reset 均已从代码删除；
# 自动退出只使用深度/冲击/亏损有界策略。
# 跨全市场的绝对风控红线 (USDC)
GLOBAL_MAX_BUDGET=280.0
# 单市场最大允许持仓敞口 (USDC)，触碰后引擎将强制平仓该市场
MAX_EXPOSURE_PER_MARKET=40.0
# 账本与 Polymarket API 持仓的差异容忍度 (超过此差异即覆盖本地账本)
EXPOSURE_TOLERANCE=0.01
# 本地刚产生成交后的缓冲秒数，期间内禁止 REST API 强行覆盖本地账本
RECONCILIATION_BUFFER_SECONDS=8.0
RECONCILIATION_INTERVAL_SEC=300
# 行情超过此年龄立即撤掉已知挂单并停止报价。
MARKET_DATA_MAX_AGE_SEC=5.0
MARKET_DATA_MAX_FUTURE_SKEW_SEC=2.0
# live 默认要求交易所 sequence 与 timestamp；缺失时 readiness 不通过。
MARKET_DATA_REQUIRE_SEQUENCE_LIVE=True
MARKET_DATA_REQUIRE_EXCHANGE_TIMESTAMP_LIVE=True

# ==========================================
# 5. 网格做市与订单参数
# ==========================================
# 每单 outcome shares（不是 USDC）；BUY 名义约等于 price * shares。
BASE_ORDER_SIZE=5.0
# 买卖双方各自挂单的网格层数
GRID_LEVELS=2
# 基础点差，决定买卖单距离 Fair Value 的远近
QUOTE_BASE_SPREAD=0.02
# Fair Value 至少移动多少金额才会触发重新挂单
QUOTE_PRICE_OFFSET_THRESHOLD=0.01
# 自动退出只能消耗该价格冲击范围内的可见买盘，且不得突破成本亏损下限。
EXIT_MAX_BOOK_IMPACT=0.02
EXIT_MAX_REALIZED_LOSS_FRACTION=0.10
# 默认禁止新增风险；只有离线回放、markout、费用/奖励归因通过后才允许显式开启。
OFFLINE_VALIDATED_ALPHA_ENABLED=False
ALPHA_STRATEGY_ID=maker-alpha-v2
# 上述布尔值不再是充分条件；还必须提供本地 JSON 证据和固定 SHA-256。
# 示例文件故意无效，仅用于说明字段：spec/alpha_evidence.example.json
ALPHA_VALIDATION_REPORT_PATH=
ALPHA_VALIDATION_REPORT_SHA256=
ALPHA_EVIDENCE_MIN_FILLS=1000
ALPHA_EVIDENCE_MIN_MARKETS=20
ALPHA_EVIDENCE_MIN_DATASET_DAYS=30.0
ALPHA_EVIDENCE_MAX_AGE_DAYS=30.0
ALPHA_EVIDENCE_MAX_DRAWDOWN_FRACTION=0.25
# reward 不计入准入；净边际 = fair-price-执行成本缓冲-逆向选择缓冲。
MIN_EXPECTED_NET_EDGE=0.02
EXECUTION_COST_BUFFER=0.002
ADVERSE_SELECTION_BUFFER=0.01

# --- 交易细节优化 ---
# 第一档买单最高允许挂在 Best Bid 之下 1 tick，这样更容易接盘成交，且保持利润空间
QUOTE_BID_ONE_TICK_BELOW_TOUCH=true
# 若难以成交，可关掉此项严格挂在 bid_1；或者提高 GRID_LEVELS 多挂几档。

# ==========================================
# 6. V4.0 全自动路由与组合管理器 (Auto-Router)
# ==========================================
AUTO_ROUTER_ENABLED=false
# 系统最多允许同时做市的市场数量 (名额)
AUTO_ROUTER_MAX_MARKETS=8
# 每隔多少秒全网扫描并重组优胜劣汰市场
AUTO_ROUTER_SCAN_INTERVAL_SEC=3600

# ==========================================
# 7. 仪表盘(Dashboard) 与 Gamma API
# ==========================================
# 仪表盘 "Screener" 从 Gamma API 拉取用于分析的最大活跃市场数
# GAMMA_MAX_MARKETS=50000

# 定力锁：市场掉出 Top N 后至少持有多少小时才允许驱逐
AUTO_ROUTER_MIN_HOLD_HOURS=2.0

# V7.0 Auto-Router: skip markets with daily reward pool below this (USD)
AUTO_ROUTER_MIN_REWARD_POOL=50.0

# V7.1 Official Polymarket Builder API credentials (order attribution)
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# --- V6.2 行业与事件地平线风控 ---
MAX_EXPOSURE_PER_SECTOR=300.0
EVENT_HORIZON_HOURS=72.0
MAX_SLOTS_PER_SECTOR=2

MAX_EXPOSURE_CATEGORICAL=30.0

# --- Paper-only Auto-Router 市场质量研究过滤 ---
# 任一盘口字段缺失或请求失败都会拒绝候选，不会 fail-open。
# 订单簿深度(前3档总名义)低于此值的市场不选
ROUTER_MIN_BOOK_DEPTH_USD=50.0
# 买卖价差超过此值的市场不选
ROUTER_MAX_BOOK_SPREAD=0.08
# 中间价在 0.50 ± 此范围内的市场不选(最大不确定性区间)
ROUTER_AVOID_MIDPOINT_BAND=0.10
